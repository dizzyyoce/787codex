---
// Fonts are bundled with the site (no Google Fonts request; they also work offline)
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/400-italic.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-sans-3/700.css";
import "../styles/base.css";
import "../styles/extra.css";
import { DATA, SECTIONS, url, fmtDate, newestVideos, ytId } from "../lib/data.js";
import { GOATCOUNTER } from "../lib/config.js";

const { title, description, section, compactHeader = true, image = "og/default.png", noindex = false } = Astro.props;
const fullTitle = title ? `${title} · 787prada Codex` : "787prada Codex";
const desc = description || "A community reference compiled from 787prada’s PoE2 build guides, mechanics breakdowns and strategy videos.";
const nv = newestVideos(1)[0];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={desc}>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
<meta property="og:type" content="website">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={desc}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL(url(image), Astro.site)}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="787prada Codex">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={new URL(url(image), Astro.site)}>
<link rel="icon" href={url("logo.jpg")}>
<link rel="manifest" href={url("manifest.webmanifest")}>
<link rel="apple-touch-icon" href={url("icon-192.png")}>
<meta name="theme-color" content="#15161a">
{GOATCOUNTER && <script is:inline async data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>}
</head>
<body data-base={url()} data-sw={url("sw.js")}>
<header class={"top wrap" + (compactHeader ? " compact" : "")}>
 <div class="intro">
  <div class="brand"><a class="home" href={url()}><h1>787prada Codex</h1></a><span class="updated">Updated {fmtDate(DATA.updated)}</span></div>
  {!compactHeader && <p class="lead">{desc}</p>}
  {!compactHeader && <div class="newest"><b>Newest video:</b> <a href={nv.url} target="_blank" rel="noopener">{nv.title}</a></div>}
 </div>
 {!compactHeader && ytId(nv.url) && (
 <a class="nv-thumb" href={nv.url} target="_blank" rel="noopener" aria-label={`Watch the newest video: ${nv.title}`}>
  <img src={`https://i.ytimg.com/vi/${ytId(nv.url)}/mqdefault.jpg`} alt="" width="320" height="180">
  <span class="nv-play" aria-hidden="true">▶</span>
 </a>)}
 <div class="side">
  <a href={url()}><img class="logo" src={url("logo.jpg")} alt="787prada" width="150" height="120"></a>
  {!compactHeader && (
  <div class="socials">
   <a href="https://www.youtube.com/@787" target="_blank" rel="noopener" aria-label="787prada on YouTube"><img src={url("youtube.png")} alt="YouTube"></a>
   <a href="https://www.twitch.tv/787prada" target="_blank" rel="noopener" aria-label="787prada on Twitch"><img src={url("twitch.png")} alt="Twitch"></a>
  </div>)}
 </div>
</header>
<div class="bar">
  <div class="wrap">
    <div class="search" id="search">
      <label for="pq" style="position:absolute;left:-9999px">Search the Codex</label>
      <input id="pq" type="search" placeholder="Search builds, skills, mechanics…" autocomplete="off" spellcheck="false"
        role="combobox" aria-expanded="false" aria-controls="pres" aria-autocomplete="list">
      <kbd class="hide-touch skey">/</kbd>
      <div class="sdrop" id="palette" hidden>
        <div class="sres">
          <ul id="pres" role="listbox" aria-label="Search results"></ul>
          <div class="palette-foot hide-touch"><span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>Enter</kbd> open</span><span><kbd>Ctrl</kbd>+<kbd>Enter</kbd> new tab</span><span><kbd>Esc</kbd> close</span></div>
        </div>
        <div class="sprev" id="sprev" aria-live="polite"></div>
      </div>
    </div>
    <nav class="tabs" aria-label="Sections">
      {SECTIONS.map((s) => (
        <a href={url(s.path)} data-tab={s.key} aria-current={s.key === section ? "page" : undefined}>{s.italic ? <>{s.label.replace(s.italic, "").trim()} <em>{s.italic}</em></> : s.label}<span class="n">{s.count}</span></a>
      ))}
    </nav>
  </div>
</div>
<main class="wrap" id="main">
  <slot />
</main>
<footer class="wrap">
  Compiled from 787prada's videos. Status shows whether a build still works as covered; "Last checked" is the patch it was last confirmed on.{" "}
  <a href={url("787prada_Codex.xlsx")}>Download the spreadsheet (.xlsx)</a>.
  <span class="hide-touch"> Press <kbd>/</kbd> to search.</span>
</footer>

<div class="hovercard" id="hovercard" hidden></div>

<script>
  import "../scripts/palette.js";
  import "../scripts/hovercard.js";
  import "../scripts/personal.js";
</script>
</body>
</html>
