---
import Linked from "../../components/Linked.astro";
import Base from "../../layouts/Base.astro";
import VideoPanel from "../../components/VideoPanel.astro";
import { DATA, V, M, url, buildUrl, mechUrl, statusClass, short, tagClass, OLD_MECH_SLUGS } from "../../lib/data.js";

export function getStaticPaths() {
  return [
    ...DATA.mechanics.map((m) => ({ params: { slug: m.slug }, props: { m } })),
    // Old links to renamed mechanics forward to the current page.
    ...Object.entries(OLD_MECH_SLUGS).filter(([old, id]) => M[id] && M[id].slug !== old)
      .map(([old, id]) => ({ params: { slug: old }, props: { m: M[id], forward: true } })),
  ];
}
const { m, forward } = Astro.props;
const usedBy = DATA.builds.filter((b) => b.mechIds.includes(m.id));
const more = m.more.map((id) => V[id]).filter(Boolean);
---
{forward ? <html lang="en"><head><meta charset="utf-8"><meta name="robots" content="noindex"><meta http-equiv="refresh" content={`0; url=${mechUrl(m)}`}><link rel="canonical" href={mechUrl(m)}><title>{m.head}</title></head><body><p>This page has moved: <a href={mechUrl(m)}>{m.head}</a></p></body></html> :
<Base title={m.head} section="mechanics" image={`og/mechanics/${m.slug}.png`} description={short(m.desc, 160)}>
  <div class="detail">
    <div class="crumbs"><a href={url("mechanics/")}>Mechanics</a> › {m.type}</div>
    <div class="dgrid text-first">
    <VideoPanel main={m.video} more={m.more} />
    <article class="card">
      <div class="dhead"><h1 class="dtitle">{m.head}</h1><button type="button" class="star big" data-fav={m.fav} aria-pressed="false" aria-label="Add to favourites" title="Add to favourites">☆</button></div>
      <div class="meta"><span class={tagClass("mtype", m.type)}>{m.type === "Engine" ? "Engine (used by many builds)" : "Tip"}</span>{m.patch && <span class="chip">Patch {m.patch}</span>}</div>
      <Linked text={m.full || m.desc} exclude={m.id} />
      {m.notes && !m.notesUrl && <p class="note">{m.notes}</p>}
      {m.notesUrl && <div class="links"><a class="btn" href={m.notesUrl} target="_blank" rel="noopener">{m.notes} ↗</a></div>}
      {usedBy.length > 0 && <>
        <h3>Builds that use this</h3>
        <ul class="related">{usedBy.map((b) => <li><a href={buildUrl(b)} data-hc={"b:" + b.id}>{b.name}{b.version ? ` (${b.version})` : ""}</a> <span class={"pill " + statusClass(b.status)}>{b.status}</span></li>)}</ul>
      </>}
    </article>
    </div>
  </div>
</Base>
}
