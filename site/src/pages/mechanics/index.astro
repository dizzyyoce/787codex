---
import Base from "../../layouts/Base.astro";
import Filters from "../../components/Filters.astro";
import { DATA, mechUrl, tagClass, mechanicsNewest } from "../../lib/data.js";
const list = mechanicsNewest();
const groups = [
  { type: "Engine", label: "Engine (used by many builds)", id: "engines" },
  { type: "Tip", label: "Tip", id: "tips" },
].map((g) => ({ ...g, items: list.filter((m) => m.type === g.type) })).filter((g) => g.items.length);
---
<Base title="Mechanics" section="mechanics" description="Engines and tips from 787prada's PoE2 videos: Boneshatter movement, Wolf Pack charges, Culling Strike and more.">
  <Filters noun="entries" favs placeholder="Filter mechanics…" fields={[{ key: "type", label: "Type", values: ["Engine", "Tip"] }]} />
  <div class="acc-tools">
    <div class="jumps">{groups.map((g) => <a class={tagClass("mtype", g.type)} href={"#" + g.id}>{g.label} · {g.items.length}</a>)}</div>
  </div>
  {groups.map((g) => (
    <section class="acc-group" data-group>
      <h2 class="section grp" id={g.id}><span class={tagClass("mtype", g.type)}>{g.label}</span><span class="n">{g.items.length}</span></h2>
      <div class="acc">{g.items.map((m) => (
        <div class="acc-item" data-row data-id={m.fav} data-type={m.type} id={m.id.toLowerCase()}
          data-text={[m.name, m.desc, m.notes].filter(Boolean).join(" ").toLowerCase()}>
          <div class="acc-line"><a class="title" href={mechUrl(m)} data-hc={"m:" + m.id}>{m.head}</a>{m.patch && <span class="chip">Patch {m.patch}</span>}</div>
          <button type="button" class="star" data-fav={m.fav} aria-pressed="false" aria-label="Add to favourites" title="Add to favourites">☆</button>
        </div>))}
      </div>
    </section>))}
  <p class="empty" hidden>Nothing matches that filter.</p>
</Base>
