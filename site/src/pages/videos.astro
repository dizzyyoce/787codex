---
import Base from "../layouts/Base.astro";
import Filters from "../components/Filters.astro";
import { DATA, tagClass } from "../lib/data.js";
const list = DATA.videos.slice().sort((a, b) => b.date.localeCompare(a.date));
const types = [...new Set(list.map((v) => v.type).filter(Boolean))].sort();
---
<Base title="Videos" section="videos" description="Every 787prada video the Codex draws on, newest first.">
  <Filters noun="videos" placeholder="Filter videos…" fields={[{ key: "type", label: "Type", values: types }]} />
  <div class="tablewrap"><table class="vids"><tbody>{list.map((v) => (
    <tr data-row data-type={v.type} data-date={v.date}><td class="d">{v.date}</td><td><a href={v.url} target="_blank" rel="noopener">{v.title}</a>
      <div class="meta" style="margin-top:4px"><span class={tagClass("vtype", v.type)}>{v.type}</span><span class="chip">{v.patch}</span><span class="chip">{v.id}</span></div></td></tr>))}
  </tbody></table></div>
  <p class="empty" hidden>Nothing matches that filter.</p>
</Base>
