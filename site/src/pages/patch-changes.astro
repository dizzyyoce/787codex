---
import Linked from "../components/Linked.astro";
import Base from "../layouts/Base.astro";
import Watch from "../components/Watch.astro";
import Filters from "../components/Filters.astro";
import { DATA, B, buildUrl, byVideoDate, comparePatch } from "../lib/data.js";
// Newest patch first (many changes come from patch notes and have no video), then newest video within a patch.
const list = byVideoDate(DATA.changes.map((c, i) => ({ ...c, anchor: "c" + (i + 1) })))
  .sort((a, b) => comparePatch(b.patch, a.patch));
const patches = [...new Set(DATA.changes.map((c) => c.patch))].sort();
const groups = [...patches].sort((a, b) => comparePatch(b, a)).map((p) => ({ patch: p, id: "patch-" + String(p).replace(/[^0-9a-z]+/gi, "-"), items: list.filter((c) => c.patch === p) }));
---
<Base title="Patch changes" section="changes" description="Patch changes that affected 787prada's PoE2 builds, and which builds they hit.">
  <Filters noun="changes" favs placeholder="Filter patch changes…" fields={[{ key: "patch", label: "Patch", values: patches }]} />
  <div class="acc-tools">
    <div class="jumps">{groups.map((g) => <a class="chip" href={"#" + g.id}>Patch {g.patch} · {g.items.length}</a>)}</div>
    <div class="links"><button type="button" class="btn" data-acc-all="open">Open all</button><button type="button" class="btn" data-acc-all="close">Close all</button></div>
  </div>
  {groups.map((g) => (
    <section class="acc-group" data-group>
      <h2 class="section grp" id={g.id}><span class="chip">Patch {g.patch}</span><span class="n">{g.items.length}</span></h2>
      <div class="acc">{g.items.map((c) => (
        <div class="acc-item" data-row data-id={c.fav} data-patch={c.patch} id={c.anchor}>
          <details>
            <summary>{c.head}</summary>
            <div class="acc-body">
              <Linked text={c.what} /><p class="small"><b>Affects:</b> {c.affects}</p>
              {c.buildIds.length > 0 && <div class="meta">{c.buildIds.map((id) => B[id]).map((b) => (
                <a class="chip tag" href={buildUrl(b)} data-hc={"b:" + b.id}>{b.name}{b.version ? ` (${b.version})` : ""}</a>))}</div>}<p class="small">Source: {c.source}</p>
              <div class="links"><Watch id={c.video} /></div>
            </div>
          </details>
          <button type="button" class="star" data-fav={c.fav} aria-pressed="false" aria-label="Add to favourites" title="Add to favourites">☆</button>
        </div>))}
      </div>
    </section>))}
  <p class="empty" hidden>Nothing matches that filter.</p>
  <script>import "../scripts/acc.js";</script>
</Base>
