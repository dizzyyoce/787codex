---
import Linked from "../../components/Linked.astro";
import Base from "../../layouts/Base.astro";
import VideoPanel from "../../components/VideoPanel.astro";
import BuildTags from "../../components/BuildTags.astro";
import { DATA, B, M, V, url, buildUrl, mechUrl, statusClass, short, relatedBuilds } from "../../lib/data.js";

export function getStaticPaths() {
  return DATA.builds.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}
const { b } = Astro.props;
const newer = b.supersededById ? B[b.supersededById] : null;
const older = b.olderIds.map((id) => B[id]);
const video = b.video ? V[b.video] : null;
const related = relatedBuilds(b);
const changes = b.changeIdx.map((i) => ({ ...DATA.changes[i], n: i + 1 }));
---
<Base title={b.name + (b.version ? ` (${b.version})` : "")} section="builds" image={`og/builds/${b.slug}.png`}
  description={`${b.name}: ${b.cls} ${b.asc} build from 787prada. ${short(b.tech, 140)}`}>
  <div class="detail">
    <div class="crumbs"><a href={url("builds/")}>Builds</a> › {b.asc}</div>
    <div class="dgrid text-first">
    <VideoPanel main={b.video} label="Build guide" />
    <article class="card">
      <div class="dhead"><h1 class="dtitle" data-date={video ? video.date : undefined}>{b.name}</h1><button type="button" class="star big" data-fav={b.id} aria-pressed="false" aria-label="Add to favourites" title="Add to favourites">☆</button></div>
      {b.version && <div class="ver">{b.version}</div>}
      <div class="meta">
        <BuildTags b={b} />
        {b.nick && <span class="nick">“{b.nick}”</span>}
      </div>
      {newer && <p class="note">There’s a newer version: <a href={buildUrl(newer)} data-hc={"b:" + newer.id}>{newer.name}{newer.version ? ` (${newer.version})` : ""}</a></p>}
      {!newer && b.supersededBy && <p class="note">Newer version: {b.supersededBy}</p>}

      <h3>Main skills</h3>
      <div class="skills">{b.skills}</div>

      <h3>Key tech</h3>
      <Linked text={b.tech} />

      {b.mechParts.length > 0 && <>
        <h3>Mechanics used</h3>
        <ul class="mechlist">{b.mechParts.map((p) => <li>{p.id
          ? <a class="chip" href={mechUrl(M[p.id])} data-hc={"m:" + p.id}>{p.text}</a>
          : <span class="chip">{p.text}</span>}</li>)}</ul>
      </>}

      {changes.length > 0 && <>
        <h3>Patch changes affecting this build</h3>
        <ul class="related changes">{changes.map((c) => (
          <li><span class="chip">Patch {c.patch}</span> <a href={url(`patch-changes/#c${c.n}`)}><b>{c.head}</b></a>
            <span class="small">{c.what}</span></li>))}</ul>
      </>}

      <div class="links">
        {b.ninja ? <a class="btn" href={b.ninja} target="_blank" rel="noopener">poe.ninja ↗</a>
          : b.ninjaNote && <span class="btn off">poe.ninja: {String(b.ninjaNote).toLowerCase()}</span>}
        {b.moba && <a class="btn" href={b.moba} target="_blank" rel="noopener">Mobalytics ↗</a>}
      </div>

      <dl>
        <dt>Last checked</dt><dd>Patch {b.checked}</dd>
        {video && <><dt>Video</dt><dd>{video.title} ({video.date})</dd></>}
        {b.family && <><dt>Family</dt><dd>{b.family}</dd></>}
      </dl>

      {older.length > 0 && <>
        <h3>Earlier versions</h3>
        <ul class="related">{older.map((o) => <li><a href={buildUrl(o)} data-hc={"b:" + o.id}>{o.name}{o.version ? ` (${o.version})` : ""}</a> <span class={"pill " + statusClass(o.status)}>{o.status}</span></li>)}</ul>
      </>}
      {related.length > 0 && <>
        <h3>Related builds</h3>
        <ul class="related">{related.map(({ o, why }) => (
          <li><a href={buildUrl(o)} data-hc={"b:" + o.id}>{o.name}{o.version ? ` (${o.version})` : ""}</a>
            <span class={"pill " + statusClass(o.status)}>{o.status}</span><span class="small">{why}</span></li>))}</ul>
      </>}
    </article>
    </div>
  </div>
</Base>
