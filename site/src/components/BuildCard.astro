---
import { buildUrl, statusClass } from "../lib/data.js";
import Watch from "./Watch.astro";
const { b } = Astro.props;
---
<article class="card" data-row
  data-cls={b.cls} data-asc={b.asc} data-status={b.status} data-patch={b.patch}
  data-text={[b.name, b.version, b.nick, b.cls, b.asc, b.skills, b.tech, b.mech].filter(Boolean).join(" ").toLowerCase()}>
  <h2><a class="title" href={buildUrl(b)} data-hc={"b:" + b.id}>{b.name}</a>{b.version && <span class="ver">{b.version}</span>}</h2>
  <div class="meta">
    <span class={"pill " + statusClass(b.status)}>{b.status}</span>
    <span class="chip">{b.cls}</span><span class="chip">{b.asc}</span><span class="chip">Patch {b.patch}</span>
    {b.nick && <span class="nick">“{b.nick}”</span>}
  </div>
  <div class="skills">{b.skills}</div>
  <p class="text">{b.tech}</p>
  <div class="links">
    <Watch id={b.video} />
    {b.ninja ? <a class="btn" href={b.ninja} target="_blank" rel="noopener">poe.ninja ↗</a>
      : b.ninjaNote && <span class="btn off">poe.ninja: {String(b.ninjaNote).toLowerCase()}</span>}
    <a class="btn" href={buildUrl(b)}>Details →</a>
  </div>
</article>
